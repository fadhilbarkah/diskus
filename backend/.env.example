# Diskus Backend Environment Variables

# The port where the backend API will run
PORT=3000

# REQUIRED: Secret key for signing JWT tokens (use a random string of 32+ characters)
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-secret-key

# Dashboard origin for admin API CORS restriction (optional, defaults to '*' in dev)
# In production, set this to your dashboard URL
# Multiple origins can be comma-separated
# DASHBOARD_ORIGIN=https://dashboard.yourdomain.com

# Database file path (optional, defaults to 'sqlite.db')
# DATABASE_PATH=sqlite.db

# Resend email configuration (optional)
# RESEND_SENDER_EMAIL=noreply@yourdomain.com
